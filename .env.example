# SQLite works out of the box. For the compose PostgreSQL service from the host:
# DATABASE_URL=postgresql+psycopg://teampulse:<POSTGRES_PASSWORD>@127.0.0.1:15432/teampulse
DATABASE_URL=sqlite:///./data/teampulse.db
SEED_DEMO=true
# Required when SEED_DEMO=true or SEED_COMPANY=true. Set a local demo password before first launch.
DEMO_PASSWORD=TeamPulse-demo-2026!
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8787,http://localhost:8787
APP_TIMEZONE=Asia/Kolkata
# Optional chat-completions-compatible provider. No key = clearly labeled offline planning.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# User-supplied employee accounts and illustrative reporting/work data.
SEED_COMPANY=true

# PostgreSQL service in compose.yaml.
POSTGRES_PASSWORD=
POSTGRES_PORT=15432

# Identity. Set JWT_SECRET (32+ characters) in production; without it a local key is kept in data/.
JWT_SECRET=
ALLOWED_EMAIL_DOMAINS=flodataanalytics.com
APP_URL=http://127.0.0.1:8787

# Google Chat app (see docs/GOOGLE_CHAT.md). Leave empty to keep it off.
# Audience: the Cloud project number, or the endpoint URL, matching the Chat API's authentication setting.
GOOGLE_CHAT_AUDIENCE=
# Service-account JSON key used to send messages (scope chat.bot).
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=

# Proactive assistant (docs/PROACTIVE_ASSISTANT_PLAN.md). Off until enabled.
PROACTIVE_ENABLED=false
# Dry run composes and stores check-ins without sending them to Google Chat.
PROACTIVE_DRY_RUN=true
# Defaults to APP_TIMEZONE when empty.
ORG_TIMEZONE=
CHECKIN_HOUR=10
CHECKIN_MAX_ITEMS=4
UNDO_WINDOW_MINUTES=120
# Pilot startup (scripts/pilot.ps1): your reserved ngrok domain, without https://. APP_URL should be https://<this domain>.
NGROK_DOMAIN=
